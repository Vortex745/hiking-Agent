# ==================== LLM 配置 ====================
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-llm-api-key
OPENAI_MODEL=deepseek-v4-flash

# ==================== Embedding 配置 ====================
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ==================== Rerank 配置（可选） ====================
RERANK_BASE_URL=https://api.openai.com/v1
RERANK_API_KEY=your-rerank-api-key
RERANK_MODEL=Qwen/Qwen3-Reranker-8B
RERANK_ENABLED=true

# ==================== 数据库配置 ====================
POSTGRES_DB=ai_hiking
POSTGRES_USER=ai_hiking
POSTGRES_PASSWORD=ai_hiking
# 可选：使用 Neon 等外部 Postgres 时填写完整连接串，会覆盖上面的本地 Compose 数据库
DATABASE_URL=
# 可选：Vercel/Neon serverless 冷启动时可适当调大
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# ==================== 内存配置 ====================
# 可选：Vercel Marketplace Redis/Upstash 可注入 REDIS_URL、KV_URL 或 UPSTASH_REDIS_URL
REDIS_URL=
# 可选：如果 Marketplace 只注入 REST 变量，AI Service 会通过 Upstash REST API 存取聊天历史
KV_URL=
UPSTASH_REDIS_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==================== 高德地图 API（可选） ====================
AMAP_API_KEY=

# ==================== 云知识库 API（可选） ====================
RAG_DOCS_API_URL=

# ==================== 服务端口 ====================
FRONTEND_PORT=3000
ALLOWED_ORIGINS=http://localhost:3000

# ==================== Chat runtime rollout ====================
# Use a high-entropy server-only value. Empty keeps all new traffic on v1.
CHAT_RUNTIME_SECRET=
# Allowed: 0, internal, 1, 5, 25, 50, 100
CHAT_V2_CANARY=0
# Allowed: empty, v1, v2. v2 is honored only in staging/trusted environments.
CHAT_RUNTIME_FORCE=
# Allowed: production, internal, staging, trusted
CHAT_RUNTIME_ENVIRONMENT=production
# Gateway: 信任的代理网段（限流按 X-Forwarded-For 解析真实客户端 IP）。
# Docker 部署用 compose 网桥网段 172.16.0.0/12；本地开发保持默认。
TRUSTED_PROXIES=127.0.0.1,::1

# ==================== RAG（可选） ====================
# RAG 查询已运行在 kernel（profile=rag）；检索存储为 SQLite 唯一后端。
# 此处仅配置库文件路径（默认 data/rag.sqlite）。
RAG_SQLITE_DB_PATH=

# ==================== Chat v2 / UniHarness（可选） ====================
# Chat v2 runtime（长期 Docker 单写实例；Vercel 上必须保持 false）。
AGENT_V2_ENABLED=false
# 固定 UniHarness fork 基线的 commit pin。
AGENT_V2_UNIHARNESS_PIN=
# v2 状态目录（checkpoints/control/memory SQLite）。
AGENT_V2_STATE_DIR=
# sandbox 类型：local_native | wsl_localvm | remote_e2b。
AGENT_V2_SANDBOX_TYPE=remote_e2b
# cowork 策略：disabled | internal | enabled。
AGENT_V2_COWORK_POLICY=disabled
# 服务端 subagent 开关。
AGENT_V2_SUBAGENT_ENABLED=false

# ==================== 飞书云文档（可选） ====================
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DEFAULT_SPACE_ID=
FEISHU_DEFAULT_FOLDER_TOKEN=

# ==================== 搜索 / 图像（可选） ====================
# Tavily web 搜索（tools/web_search.py）。
TAVILY_API_KEY=
# Pexels 图像搜索 MCP server（mcp_servers/pexels_server.py）。
PEXELS_API_KEY=
# 禁用的能力通道，逗号分隔。
DISABLED_LANES=

# ==================== 记忆系统（可选） ====================

# ==================== Rerank 细节（可选） ====================
RERANK_TOP_K=4
RERANK_TIMEOUT_SECONDS=15

# ==================== Langfuse LLM 可观测性（可选） ====================
# 未配置 key 时自动禁用（零回归）。注册 https://cloud.langfuse.com 免费获取密钥。
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 自托管 Langfuse 时改为自建实例地址。
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 头部采样比例（0 = 不导出，1 = 全量导出）。低比例下错误 trace 可能被丢弃，
# stdout 日志是错误权威记录。
OBSERVABILITY_SAMPLE_RATIO=1.0

# ==================== stdout 日志 ====================
# level: DEBUG / INFO / WARNING / ERROR；format: json / text
LOG_LEVEL=INFO
LOG_FORMAT=json
