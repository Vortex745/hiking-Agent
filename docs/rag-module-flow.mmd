flowchart TD
    subgraph S1["摄入链路（IngestionPipeline 唯一路径）"]
        U2["IngestionPipeline.ingest_file"] --> U3["extract_markdown<br/>(pymupdf4llm PDF→MD)"]
        U3 --> U4["split_parent_chunks<br/>(H1/H2/H3 层级)"]
        U4 --> U5["split_child_chunks<br/>(500/100 重叠)"]
        U5 --> U6["upsert_document<br/>(parent + child_vec + FTS5)"]
        U6 --> U7[("data/rag.sqlite<br/>SQLite 唯一存储后端")]
    end

    subgraph S2["知识检索工具（对模型是单次工具调用）"]
        T1["hiking_knowledge_search<br/>(tools/hiking_knowledge)"] --> T2["retrieve_subgraph 预算子图<br/>编排规划→子块检索→父块回溯→压缩→去重"]
        T2 --> T3["VectorStoreRetriever.hybrid_search<br/>(sqlite-vec + FTS5 jieba + RRF)"]
        T3 --> T7
        T2 -. "具名失败模式:<br/>子图异常退回单次混合检索" .-> T3
    end

    subgraph S4["Kernel 回合（agent_v2 唯一编排栈）"]
        K1["run_started → progress → heartbeat"] --> K2["kernel turn<br/>system prompt: 先检索后作答<br/>注来源 / 资料不足明说 / 文本追问"]
        K2 -->|"tool 调用"| T1
        K2 --> K3["grounding 门<br/>knowledge_search_attempted_<br/>without_evidence → 替换为资料不足"]
        K3 --> K4["tool_result(含 evidence) → text → done"]
        K2 --> K5["会话消息持久化<br/>(CheckpointsStore.messages)"]
    end

    subgraph S6["前端消费（SSE 直连，A11 后无独立 RAG HTTP 面）"]
        F1["POST /api/v2/chat/sse<br/>(profile=chat / route_plan)"] --> S4
        F2["检索来源块<br/>tool_result.evidence<br/>(has_chunks/sources/chunks)"]
        F3["恢复：snapshot + events<br/>（A05/A06 状态机）"]
        K4 --> F2
    end
