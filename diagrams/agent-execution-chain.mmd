%%{init: {"theme": "base", "themeVariables": {"background": "#ffffff", "primaryTextColor": "#0f172a", "lineColor": "#64748b", "fontFamily": "Arial"}}}%%
flowchart TD
    subgraph STARTUP["① 启动装配 · main.py lifespan"]
        FLAG{"AGENT_V2_ENABLED?"}
        OFF["chat 链路不可用（v1 已移除，无回退）"]
        GUARD["check_v2_startup_guard<br/>Vercel / 配置 fail-fast"]
        LOCK["OS WriterLock 单写者"]
        DBS["SQLite ×3<br/>agent_control / chat_checkpoints / agent_memory"]
        COMPONENTS["RunRepository + MemoryService<br/>Telemetry + CapacityGuard"]
        SWEEP["start_paused_run_sweeper<br/>过期 paused run 清扫"]
        V2RT["app.state.agent_v2_runtime"]
        FLAG -->|false：默认| OFF
        FLAG -->|true| GUARD --> LOCK --> DBS --> COMPONENTS --> SWEEP --> V2RT
    end

    subgraph REQ["② 请求接入 · POST /api/v2/chat/sse"]
        UI["前端 SuperAgent<br/>chatV2.ts"]
        GW["Go Gateway 转发"]
        ADP["api/chat_v2.py<br/>HTTP 解析 · Pydantic 校验 · SSE 渲染"]
        CAP["CapacityGuard 租约<br/>run / sandbox，满 → 503"]
        ORCH["RunOrchestrator.stream_chat"]
        RUN{"create_run_idempotent<br/>request_id 幂等"}
        REPLAY["重复 request_id<br/>重放已存事件后结束<br/>不重跑工具"]
        GATE["前置门禁<br/>v2 enabled · resolve_profile<br/>cowork 授权策略 · API Key"]
        EVT["run_started → progress → heartbeat<br/>emit 闭包：build → persist → telemetry → SSE"]
        CANCEL["流间歇轮询 is_cancelled<br/>→ cancelled 终态"]
        UI --> GW --> ADP --> CAP --> ORCH --> RUN
        RUN -->|重复| REPLAY
        RUN -->|新建| GATE --> EVT
        EVT -.-> CANCEL
    end

    subgraph PROFILE["③ 能力分流 · 服务端定义，客户端不可覆盖"]
        P{"resolve_profile"}
        CH["chat：敏感记忆 consent hook<br/>kernel turn + 记忆工具"]
        RG["rag：kernel turn + 知识检索<br/>grounding gate"]
        RP["route_plan：kernel turn + AMap MCP 白名单<br/>evidence 纪律 prompt"]
        AR["artifact：沙箱 PDF 流程"]
        CW["cowork：沙箱 Bash 流程<br/>需 AGENT_V2_COWORK_POLICY=trusted/staging"]
        P -->|chat| CH
        P -->|rag| RG
        P -->|route_plan| RP
        P -->|artifact| AR
        P -->|cowork| CW
    end

    subgraph KERNEL["④ Kernel turn · UniHarness 全项目唯一装配"]
        ASM["assemble_kernel_agent<br/>pin 校验 · ChatOpenAI temp 0 重试 3<br/>PermissionGate · MCP 白名单 · 子代理（默认关）"]
        CKPT["LangGraph checkpointer<br/>thread_id = v2:chat:{run_id} · 断点续跑<br/>上下文超阈值自动压缩"]
        LOOP["ReAct 循环<br/>模型推理 → PermissionGate → 工具执行<br/>结果回填 · 全程写 audit 审计"]
        FIN["收尾 fail-closed<br/>240s 超时 · 稳定错误码 · 无降级回退<br/>清洗 think 标记 → final_text"]
        ASM --> CKPT --> LOOP --> FIN
    end

    subgraph EFFECT["⑤ 副作用 CAS 账本 · drive_effect（唯一实现）"]
        AUTH["authorized<br/>执行前先落账"]
        CAS["CAS → executing<br/>唯一执行者获胜"]
        COMMIT["committed<br/>结果入库，重入直接回放"]
        FAIL["failed<br/>不重执行 · 终态错误"]
        UK["outcome_unknown<br/>执行者崩溃 · 人工审查<br/>禁自动重放"]
        AUTH -->|CAS| CAS --> COMMIT
        CAS -->|执行失败| FAIL
        CAS -->|执行者崩溃| UK
    end

    subgraph APPROVAL["⑥ 暂停 · 审批 · 恢复（artifact / cowork）"]
        NEED{"PermissionGate<br/>判定 NEEDS_APPROVAL?"}
        PAUSE["approval.required + run.paused<br/>effect 先以 authorized 落账"]
        DEC{"resolve_approval_decision<br/>approve / reject / expire 幂等"}
        RES["stream_resume<br/>重取租约 · CAS 胜者保活沙箱<br/>effect_in_flight 不重跑 · 补发缺失事件<br/>重连合成缺失终态"]
        CLN["不执行 · 沙箱清理"]
        SWEEPT["后台清扫：过期 paused 自动终结"]
        NEED -->|是| PAUSE --> DEC
        DEC -->|approve| RES
        DEC -->|reject / expire| CLN
        SWEEPT -.-> DEC
    end

    subgraph TERM["⑦ 收尾与支撑端点"]
        DONE["exactly-one-terminal<br/>text → done · error · cancelled"]
        ART["artifact 专有：artifact_candidate<br/>→ 主机校验导出 → artifact.available<br/>→ opaque id 下载"]
        SUPPORT["GET snapshot / events?from_seq（断线重放）<br/>POST cancel · approvals/:id/decision<br/>GET artifacts/:artifact_id"]
        DONE --> SUPPORT
    end

    V2RT -.-> UI
    EVT --> P
    CH --> ASM
    RG --> ASM
    RP --> ASM
    AR --> ASM
    CW --> ASM
    LOOP -->|高危工具| NEED
    NEED -->|否| LOOP
    RES --> COMMIT
    RES --> ART
    FIN --> DONE
    ART --> DONE

