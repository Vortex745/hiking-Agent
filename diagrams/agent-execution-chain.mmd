    class FLAG,RUN,P,NEED,DEC decision;
    class OFF,GUARD,LOCK,DBS,COMPONENTS,SWEEP,V2RT,CAP,ORCH,REPLAY,GATE,EVT,CANCEL,CH,RG,RP,ASM,CKPT,LOOP,FIN,AUTH,CAS,PAUSE,RES,SUPPORT process;
    class AR,CW,FAIL,UK,CLN risk;
    class COMMIT,DONE,ART ok;
