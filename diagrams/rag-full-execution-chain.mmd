flowchart TD
    UI["前端 React<br/>SSE 消费 ragQuery"]
    GW["网关 Go/Gin<br/>POST /api/v1/rag/query<br/>SSE 透传"]
    API["ai-service/api/rag.py<br/>rag_query 端点"]

    UI --> GW --> API

    CANCEL{"cancel_clarification_id<br/>取消请求?"}
    API --> CANCEL
    CANCEL -->|是| CANCELLED["ClarificationStore.cancel<br/>JSONResponse 200 / 404"]
    CANCEL -->|否| RESUME

    RESUME{"clarification_answers<br/>resume 请求?"}
    RESUME -->|是| RCHECK["resume 状态校验<br/>not_found→404 / cancelled→410<br/>expired→410 / resumed→200"]
    RCHECK -->|有效 resume| SSE_ENTER
    RCHECK -.->|无效| RESUME_FAIL["JSONResponse 直接返回"]
    RESUME -->|否| SSE_ENTER

    SSE_ENTER["进入 SSE event_stream 生成器"]
    MODE{"走 graph runtime?<br/>runtime 可用 且<br/>无 model_settings 且 无 status<br/>且 无飞书链接"}
    SSE_ENTER --> MODE
    MODE -->|否| LEGACY["Legacy 路径<br/>澄清触发 / guard / 云文档同步<br/>hybrid_search + ContextAugmenter<br/>SSE 输出（零回归）"]
    MODE -->|是| GRS

    subgraph GRS["Graph Runtime 路径（_run_graph_runtime_sse）"]
        HIST["读取 history（先读再写）<br/>persist user question（幂等）"]
        G1{"direct_rag_answer<br/>问候?"}
        G1Y["text + done<br/>persist assistant"]
        G2{"_rag_guard_answer<br/>越域 / 不清晰?"}
        G2Y["process + text + done<br/>跳过知识库检索"]
        RUN["RAGRuntime.arun<br/>run_rag_graph<br/>graph.ainvoke<br/>thread_id = chat_id"]
        INT{"is_clarification_needed?<br/>state 含 __interrupt__"}
        INTY["clarification_needed + done<br/>等待用户补充"]
        EMIT["_emit_state_sse<br/>state → SSE 事件"]
        HIST --> G1
        G1 -->|是| G1Y
        G1 -->|否| G2
        G2 -->|是| G2Y
        G2 -->|否| RUN
        RUN --> INT
        INT -->|是| INTY
        INT -->|否| EMIT
    end

    RUN -->|ainvoke 首请求| SUM

    subgraph MAIN["RAG 主图（LangGraph StateGraph · build_rag_graph）"]
        SUM["summarize_conversation<br/>滚动摘要 + 保留最近 6 条<br/>_RESET 哨兵重置跨轮累加器"]
        ANALYZE["analyze_query<br/>融合 contextualize + rewrite<br/>is_clear / 子问题≤3 / 澄清原因"]
        RT{"is_clear?"}
        CLAR["request_clarification<br/>ClarificationStore.create 幂等<br/>interrupt 暂停图执行"]
        RSM["Command(resume=answers)<br/>合并答案+原问题<br/>is_clear=True"]
        FAN["Send fan-out × N<br/>每个子问题一个实例<br/>带 question_index 保序"]
        RTR["retrieve 节点 × N 并行<br/>retriever.search(q, k=4)"]
        AGG["aggregate_answer<br/>按 question_index 保序聚合<br/>组内 md5 去重 + 冲突检测"]
        SUM --> ANALYZE --> RT
        RT -->|是| FAN
        RT -->|否·澄清模式| CLAR
        RT -->|否·默认模式| AGG
        CLAR -.interrupt 暂停.-> INTY
        CLAR -.resume.-> RSM
        RSM --> FAN
        FAN --> RTR --> AGG
    end

    subgraph RSUB["检索子图（可选 · use_retrieve_subgraph=True）"]
        ORCH["orchestrator 预算决策<br/>迭代≤5 / 工具调用≤4<br/>token 阈值 4000×80%"]
        ST["search_tool<br/>search_child / search_parent<br/>executed_queries 与 seen_parent_ids 去重"]
        CP["compress<br/>哈希去重 + 数字/版本/安全事实<br/>snippet 截断 200 字符 + 证据缺口"]
        FIN["finalizer<br/>final_docs + 观测记录<br/>无证据时显式说明"]
        ORCH -->|search_child / search_parent| ST
        ST -->|证据不足继续| ORCH
        ORCH -->|token 超阈值| CP
        CP --> ORCH
        ORCH -->|finalize| FIN
        FIN -->|final_docs 带 question_index| AGG
    end

    RTR -->|use_retrieve_subgraph=True| ORCH
    RTR -->|默认简单节点| VS

    subgraph RETR["检索后端（VectorStoreRetriever）"]
        VS["RetrieverProtocol.search<br/>hybrid_search"]
        BR["backend_resolver<br/>sqlite / pgvector / memory"]
        HBR["SQLite 混合检索 search_child_chunks<br/>dense: sqlite-vec child_vec<br/>sparse: FTS5 jieba 分词<br/>RRF 融合 k=60 + 跨 query 二次 RRF"]
        PAR["parent 回溯<br/>retrieve_parent_chunks"]
        DB[("SQLiteStore<br/>parent / child<br/>child_vec / child_fts")]
        VS --> BR --> HBR
        HBR --> PAR
        HBR --> DB
        PAR --> DB
    end

    subgraph GEN["答案生成路径（aggregate_answer 内）"]
        CONFLICT["_detect_conflicts<br/>数字/单位/版本维度<br/>如实呈现不调和"]
        AUG["ContextAugmenter 路径<br/>humanize_for_answer(question)<br/>augment → _format_answer_text<br/>clean + emphasize 安全术语"]
        LLP["LLM 路径<br/>invoke + _finalize_llm_path_answer<br/>emphasize_display_terms<br/>+ clean_display_text"]
        FB["fallback 路径<br/>_fallback_answer_grouped<br/>按子问题呈现证据 + 冲突标注"]
        CONFLICT --> AUG
        CONFLICT --> LLP
        CONFLICT --> FB
    end
    AGG --> CONFLICT

    EMIT -->|process_messages| EV_P["process 事件"]
    EMIT -->|retrieved_docs| EV_D["documents 事件<br/>summarize_retrieved_documents"]
    EMIT -->|answer| EV_T["text 事件<br/>persist assistant 到 ChatMemory"]
    EMIT --> EV_E["done 事件"]

    CPTR["Checkpointer<br/>AsyncSqliteSaver<br/>rag_checkpoints.sqlite<br/>thread_id = chat_id<br/>summary 跨轮滚动累积"]
    RUN -.读写.-> CPTR
    CLAR -.interrupt/resume 依赖.-> CPTR
